    {
      "name": "PUENTE 3",
      "time_bars": 97.1,
      "time_beats": 384.0,
      "length_bars": 16.0,
      "description": "Bridge 3: Transition toward breakdown; drum layers thin out, low-cut filter sweeps up."
    },
    {
      "name": "BREAK",
      "time_bars": 113.1,
      "time_beats": 448.0,
      "length_bars": 16.0,
      "description": "Breakdown: Kick and sub cut completely! Lush chord progression and pads fully exposed."
    },
    {
      "name": "PREDROP",
      "time_bars": 129.1,
      "time_beats": 512.0,
      "length_bars": 16.0,
      "description": "Buildup 2: Snare roll acceleration, pitch riser, white noise sweep, utility gain ducking in bar 144."
    },
    {
      "name": "MAIN DROP",
      "time_bars": 145.1,
      "time_beats": 576.0,
      "length_bars": 16.0,
      "description": "DROP :) Climax of track: All elements firing together (kick, sub, lead, chords, counter-melodies, crash)."
    },
    {
      "name": "OUTRO",
      "time_bars": 161.1,
      "time_beats": 640.0,
      "length_bars": 16.0,
      "description": "Lead cuts, chords fade, percs strip back to kick and rumble for clean DJ outro mixing."
